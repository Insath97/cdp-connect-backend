          "raw": "{{base_url}}/investor/investments?status=all&search=&branch=true&agent=true&per_page=15",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "investor",
            "investments"
          ],
          "query": [
            {
              "key": "status",
              "value": "all",
              "description": "approved | pending | active | expired | cancelled | all"
            },
            {
              "key": "search",
              "value": "",
              "description": "Search by policy number, application number, sales code or plan name"
            },
            {
              "key": "branch",
              "value": "true",
              "description": "Include branch details (name, code)"
            },
            {
              "key": "agent",
              "value": "true",
              "description": "Include servicing agent details (name, employee code)"
            },
            {
              "key": "from_date",
              "value": "",
              "description": "YYYY-MM-DD (filters reservation_date >= from_date)",
              "disabled": true
            },
            {
              "key": "to_date",
              "value": "",
              "description": "YYYY-MM-DD (filters reservation_date <= to_date)",
              "disabled": true
            },
            {
              "key": "per_page",
              "value": "15",
              "description": "1-100, default 15"
            },
            {
              "key": "all",
              "value": "false",
              "description": "Set to true to return all records unpaginated",
              "disabled": true
            },
            {
              "key": "order_by",
              "value": "reservation_date",
              "description": "reservation_date | investment_amount | policy_number | id",
              "disabled": true
            },
            {
              "key": "order_direction",
              "value": "desc",
              "description": "desc | asc",
              "disabled": true
            }
          ]
        }
