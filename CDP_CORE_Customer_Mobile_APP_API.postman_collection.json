    {
      "name": "Home Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "description": "Fetch investor mobile home dashboard metrics.",
        "url": {
          "raw": "{{base_url}}/investor/home?include_my_stats=true&include_global_total=true&include_status_stats=true&include_upcoming_payout=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "investor",
            "home"
          ],
          "query": [
            {
              "key": "include_my_stats",
              "value": "true",
              "description": "Returns invest count & total investment amount for this customer"
            },
            {
              "key": "include_global_total",
              "value": "true",
              "description": "Returns total investment amount across the entire platform"
            },
            {
              "key": "include_status_stats",
              "value": "true",
              "description": "Returns investment counts grouped by status (pending, active, expired, cancelled)"
            },
            {
              "key": "include_upcoming_payout",
              "value": "true",
              "description": "Returns the most recent UNPAID payout for this customer"
            }
